 "provisions": [
  {
   "id": "1.1",
   "number": "1.1",
   "level": 1,
   "article": "art1",
   "parent": "art1",
   "text": "Энэ хуулийн зорилт нь Монгол Улсын Эрдэнэсийн сан /цаашид \"Эрдэнэсийн сан\" гэх/-г эрхлэх, бүрдүүлэх, хамгаалах, захиран зарцуулах, хяналт тавихтай холбогдсон харилцааг зохицуулахад оршино.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "2.1",
   "number": "2.1",
   "level": 1,
   "article": "art2",
   "parent": "art2",
   "text": "Эрдэнэсийн сангийн хууль тогтоомж нь Монгол Улсын Үндсэн хууль, Төв банк /Монголбанк/-ны тухай хууль, Соёлын өвийг хамгаалах тухай хууль, Ашигт малтмалын тухай хууль, энэ хууль болон эдгээр хуультай нийцүүлэн гаргасан хууль тогтоомжийн бусад актаас бүрдэнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "2.2",
   "number": "2.2",
   "level": 1,
   "article": "art2",
   "parent": "art2",
   "text": "Валютын зохицуулалт, гадаад валютын улсын нөөцийг эзэмшиж, удирдахтай холбогдсон харилцааг энэ хуулиар зохицуулахгүй. З дугаар зүйл.Хуулийн нэр томьёоны тодорхойлолт",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1",
   "number": "3.1",
   "level": 1,
   "article": "art3",
   "parent": "art3",
   "text": "Энэ хуульд хэрэглэсэн дараах нэр томьёог доор дурдсан утгаар ойлгоно:",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1.1",
   "number": "3.1.1",
   "level": 2,
   "article": "art3",
   "parent": "3.1",
   "text": "\"эрдэнэс\" гэж түүхий эд, хайлш, химийн нэгдэл, бүтээгдэхүүн зэрэг ямар ч байдалд байгаа үнэт металл, эрдэнийн чулуу, түүх, соёлын хосгүй үнэт, үнэт дурсгалт зүйл, байгалийн төрцийг;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1.2",
   "number": "3.1.2",
   "level": 2,
   "article": "art3",
   "parent": "3.1",
   "text": "\"үнэт металл\" гэж алт, мөнгө, платина болон түүний бүлэгт багтдаг палладий, иридий, родий, рутений, осмийг;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1.3",
   "number": "3.1.3",
   "level": 2,
   "article": "art3",
   "parent": "3.1",
   "text": "\"үнэт чулуу\" гэж доржпалам, бадмаараг, маргад эрдэнэ, индранил, сувдыг;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1.4",
   "number": "3.1.4",
   "level": 2,
   "article": "art3",
   "parent": "3.1",
   "text": "\"Эрдэнэсийн сан\" гэж төрийн нэрийн өмнөөс Монголбанк эрхэлж, бүрдүүлж, хамгаалж, эзэмшиж, ашиглаж, захиран зарцуулж байгаа эрдэнэс, түүний дагалдах зүйл, хөрөнгийн хуримтлалыг;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1.5",
   "number": "3.1.5",
   "level": 2,
   "article": "art3",
   "parent": "3.1",
   "text": "\"байгалийн төрц\" гэж онцгой чамин дүрс хэлбэртэй, ховор өнгөтэй, байгалийн тогтцоороо олдсон үнэт металл, эрдэнийн чулууг;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "3.1.6",
   "number": "3.1.6",
   "level": 2,
   "article": "art3",
   "parent": "3.1",
   "text": "\"эрдэнийн чулуу\" гэж олон улсад хэвшсэн ангилалыг харгалзан эрх бүхий байгууллагаас тодорхойлсон ангилалд хамрагдах үнэт, хагас үнэт чулууг.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "4.1",
   "number": "4.1",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Эрдэнэсийн сан төрийн өмчид байна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "4.2",
   "number": "4.2",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Эрдэнэсийн санг үндсэн болон гүйлгээ санд хуваана.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "4.3",
   "number": "4.3",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Үндсэн сан байнгын болон байнгын бус хэсгээс бүрдэнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "4.4",
   "number": "4.4",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Үндсэн сангийн байнгын хэсэгт Монгол Улсын хуваагдашгүй өмч болох эрдэнэс байх бөгөөд тэдгээрийг худалдах, шилжүүлэх, захиран зарцуулахыг хориглоно.",
   "status": "хүчинтэй",
   "modality": [
    "хориглол"
   ]
  },
  {
   "id": "4.5",
   "number": "4.5",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Үндсэн сангийн байнгын бус хэсэгт олон улсын жишгээр цэвэршүүлсэн үнэт металл, засаж өнгөлсөн эрдэнийн чулуу, түүх, соёлын үнэт дурсгалт зүйл, үнэт болон бусад металлаар хийж нөөцөд авсан зоос байна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "4.6",
   "number": "4.6",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Үндсэн сангийн байнгын хэсэгт байх түүх, соёлын дурсгалт зүйл нь хосгүй үнэт зэрэглэлтэй байна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "4.7",
   "number": "4.7",
   "level": 1,
   "article": "art4",
   "parent": "art4",
   "text": "Гүйлгээ санд энэ хуулийн 4.4, 4.5-д зааснаас бусад үйлдвэрлэл, судалгаа, дурсгалын зориулалтаар гүйлгээнд оруулах эрдэнэс хамаарна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "5.1",
   "number": "5.1",
   "level": 1,
   "article": "art5",
   "parent": "art5",
   "text": "Улсын Их Хурал Эрдэнэсийн сангийн талаар дараах бүрэн эрхийг хэрэгжүүлнэ:",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "5.1.1",
   "number": "5.1.1",
   "level": 2,
   "article": "art5",
   "parent": "5.1",
   "text": "үндсэн сангийн байнгын болон байнгын бус хэсэгт байх эрдэнэсийн нэр төрөл, хэмжээг тогтоох;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "5.1.2",
   "number": "5.1.2",
   "level": 2,
   "article": "art5",
   "parent": "5.1",
   "text": "Эрдэнэсийн сангийн жилийн орлого, зарлагын хэмжээ болон гүйцэтгэлийн тайланг батлах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "5.1.3",
   "number": "5.1.3",
   "level": 2,
   "article": "art5",
   "parent": "5.1",
   "text": "үндсэн сангийн байнгын бус хэсгээс үнэт металл, үнэт чулуу худалдах, худалдан авах шийдвэр гаргах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "5.1.4",
   "number": "5.1.4",
   "level": 2,
   "article": "art5",
   "parent": "5.1",
   "text": "олборлосон үнэт металл, үнэт чулууг Эрдэнэсийн санд худалдан авах доод хэмжээг тогтоох;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "5.1.5",
   "number": "5.1.5",
   "level": 2,
   "article": "art5",
   "parent": "5.1",
   "text": "хуульд заасан бусад бүрэн эрх.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "6.1",
   "number": "6.1",
   "level": 1,
   "article": "art6",
   "parent": "art6",
   "text": "Засгийн газар Эрдэнэсийн сангийн талаар дараах бүрэн эрхийг хэрэгжүүлнэ:",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "6.1.1",
   "number": "6.1.1",
   "level": 2,
   "article": "art6",
   "parent": "6.1",
   "text": "Улсын Их Хурлаас тогтоосон хэмжээнд гүйлгээ сангаас үнэт металл, үнэт чулуу худалдах асуудлыг Монголбанктай хамтран шийдвэрлэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "6.1.2",
   "number": "6.1.2",
   "level": 2,
   "article": "art6",
   "parent": "6.1",
   "text": "Монголбанкны хүсэлтийн дагуу түүх, соёлын хосгүй үнэт дурсгалт зүйлийг Эрдэнэсийн санд шилжүүлэх шийдвэр гаргах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "6.1.3",
   "number": "6.1.3",
   "level": 2,
   "article": "art6",
   "parent": "6.1",
   "text": "хууль тогтоомжид заасан бусад бүрэн эрх.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1",
   "number": "7.1",
   "level": 1,
   "article": "art7",
   "parent": "art7",
   "text": "Монголбанк Эрдэнэсийн сангийн талаар дараах бүрэн эрхийг хэрэгжүүлнэ:",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.1",
   "number": "7.1.1",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "Эрдэнэсийн санг эрхлэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.2",
   "number": "7.1.2",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "Эрдэнэсийн сангийнэрдэнэс, хөрөнгийн хөдөлгөөний бүртгэл хийж, төлбөр тооцоог гүйцэтгэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.3",
   "number": "7.1.3",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "энэ хуулийн 5.1.3-т заасан саналыг боловсруулж, Улсын Их Хуралд хүргүүлэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.4",
   "number": "7.1.4",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "Эрдэнэсийн санд эрдэнэс худалдан авах, гүйлгээ сангаас эрдэнэс худалдах, арилжих болон үнийг тогтоох;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.5",
   "number": "7.1.5",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "эрдэнэсийн зах зээлийн үнийн судалгааг гаргах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.6",
   "number": "7.1.6",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "үнэт болон бусад металлаар хийсэн дурсгалын зоос гаргах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.7",
   "number": "7.1.7",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "Эрдэнэсийн санг эрхлэхтэй холбоотой журам батлах, холбогдох шийдвэр гаргах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "7.1.8",
   "number": "7.1.8",
   "level": 2,
   "article": "art7",
   "parent": "7.1",
   "text": "хууль тогтоомжид заасан бусад бүрэн эрх.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1",
   "number": "8.1",
   "level": 1,
   "article": "art8",
   "parent": "art8",
   "text": "Эрдэнэсийн санг эрхлэхэд дараах үйл ажиллагаа хамаарна:",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.1",
   "number": "8.1.1",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "худалдах, худалдан авах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.2",
   "number": "8.1.2",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "хадгалах, хадгалуулах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.3",
   "number": "8.1.3",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "хамгаалах, байршуулах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.4",
   "number": "8.1.4",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "нэмэгдүүлэх, зарцуулах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.5",
   "number": "8.1.5",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "үйлдвэрлэх, үйлдвэрлүүлэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.6",
   "number": "8.1.6",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "үнэлэх, үнэлүүлэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.7",
   "number": "8.1.7",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "цэвэршүүлэх;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.8",
   "number": "8.1.8",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "сэргээн засварлах, арчлах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.9",
   "number": "8.1.9",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "үзэсгэлэн зохион байгуулах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.10",
   "number": "8.1.10",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "мэдээлэх, хэвлэх, нийтлэх, сурталчлах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.11",
   "number": "8.1.11",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "бүртгэх, тоолох;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "8.1.12",
   "number": "8.1.12",
   "level": 2,
   "article": "art8",
   "parent": "8.1",
   "text": "бусад.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "9.1",
   "number": "9.1",
   "level": 1,
   "article": "art9",
   "parent": "art9",
   "text": "Энэ хуулийн 8 дугаар зүйлд заасан үйл ажиллагааг эрхлэх нэгж Монголбанкны бүтцэд байна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "9.2",
   "number": "9.2",
   "level": 1,
   "article": "art9",
   "parent": "art9",
   "text": "Монголбанкны Ерөнхийлөгч Эрдэнэсийн санг эрхлэх нэгжийн бүтэц, орон тоо, цалингийн санг Монголбанкны төсөвт багтаан тогтооно.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "9.3",
   "number": "9.3",
   "level": 1,
   "article": "art9",
   "parent": "art9",
   "text": "Эрдэнэсийн сан нь эрдэнэс худалдан авахад санал, дүгнэлт гаргах чиг үүрэг бүхий мэргэжлийн зөвлөлтэй байна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "9.4",
   "number": "9.4",
   "level": 1,
   "article": "art9",
   "parent": "art9",
   "text": "Энэ хуулийн 9.3-т заасан мэргэжлийн зөвлөлийн бүрэлдэхүүн, ажиллах журмыг Монголбанкны Ерөнхийлөгч батална.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "10.1",
   "number": "10.1",
   "level": 1,
   "article": "art10",
   "parent": "art10",
   "text": "Эрдэнэсийн сангийн орлого нь иргэн, хуулийн этгээдээс төрд худалдсан, бэлэглэсэн, хандивласан болон хууль тогтоомжийн дагуу шилжүүлсэн эрдэнэсээс бүрдэнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "11.1",
   "number": "11.1",
   "level": 1,
   "article": "art11",
   "parent": "art11",
   "text": "Эрдэнэсийн сангийн гүйлгээ сангаас дараах байдлаар зарлага гаргана:",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "11.1.1",
   "number": "11.1.1",
   "level": 2,
   "article": "art11",
   "parent": "11.1",
   "text": "үнэт металл, эрдэнийн чулуу, зоосыг Монголбанкнаас тогтоосон үнээр худалдах;",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "11.1.2",
   "number": "11.1.2",
   "level": 2,
   "article": "art11",
   "parent": "11.1",
   "text": "үнэт металл, эрдэнийн чулууг засах, цэвэршүүлэх явцад гарсан хорогдлыг хасах.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "12.1",
   "number": "12.1",
   "level": 1,
   "article": "art12",
   "parent": "art12",
   "text": "Монголбанк Эрдэнэсийн сангийн эрдэнэс, бусад хөрөнгийн хувийн хэргийг хөтөлж, Эрдэнэсийн сангийн бүртгэл, мэдээллийн санд бүртгэнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "12.2",
   "number": "12.2",
   "level": 1,
   "article": "art12",
   "parent": "art12",
   "text": "Монголбанк Эрдэнэсийн сангийн хөрөнгийн нягтлан бодох бүртгэлийг хөтөлж, өөрийн санхүүгийн тайланд тусгана.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "12.3",
   "number": "12.3",
   "level": 1,
   "article": "art12",
   "parent": "art12",
   "text": "Энэ хуулийн 12.1-д заасан бүртгэл, мэдээллийн сангийн журмыг Монголбанкны Ерөнхийлөгч батална.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "13.1",
   "number": "13.1",
   "level": 1,
   "article": "art13",
   "parent": "art13",
   "text": "Эрдэнэсийн чанар байдлыг нь алдагдуулахгүйгээр тусгай зориулалтын байр, саванд хадгална.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "13.2",
   "number": "13.2",
   "level": 1,
   "article": "art13",
   "parent": "art13",
   "text": "Монголбанк эрдэнэсийг эзэмшигч, өмчлөгч иргэн, хуулийн этгээдтэй байгуулсан гэрээний үндсэн дээр хадгалах, түүнтэй холбоотой ажил, үйлчилгээг үзүүлж болно.",
   "status": "хүчинтэй",
   "modality": [
    "эрх"
   ]
  },
  {
   "id": "14.1",
   "number": "14.1",
   "level": 1,
   "article": "art14",
   "parent": "art14",
   "text": "Эрдэнэсийн сан төрийн хамгаалалтад байна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "14.2",
   "number": "14.2",
   "level": 1,
   "article": "art14",
   "parent": "art14",
   "text": "Эрдэнэсийн сангийн хамгаалалтыг Монголбанктай байгуулсан гэрээний дагуу цагдаагийн байгууллага эрхлэн гүйцэтгэнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "14.3",
   "number": "14.3",
   "level": 1,
   "article": "art14",
   "parent": "art14",
   "text": "Эрдэнэсийн сангаас эрдэнэсийг бусад газар шилжүүлэх, байршуулах, тээвэрлэх ажлыг энэ хуулийн 14.4-т заасан журмын дагуу гүйцэтгэнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "14.4",
   "number": "14.4",
   "level": 1,
   "article": "art14",
   "parent": "art14",
   "text": "Эрдэнэсийн сангийн тээвэрлэлт, харуул, хамгаалалтын журмыг Монголбанкны Ерөнхийлөгч болон Цагдаагийн төв байгууллагын дарга хамтран батална.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "15.1",
   "number": "15.1",
   "level": 1,
   "article": "art15",
   "parent": "art15",
   "text": "Монгол Улсын нутаг дэвсгэрт эрдэнэс эзэмшигч хүн, хуулийн этгээд, бусад байгууллага нь эрдэнэсийн санд худалдах эрдэнэс, тэдгээрээр хийсэн эдлэлийг сорьц тогтоох эрх бүхий хуулийн этгээд, эсхүл сорьцын асуудалэрхэлсэн төрийн захиргааны байгууллагаар сорьц тогтоолгон баталгаажуулсан байх үүрэгтэй.",
   "status": "хүчинтэй",
   "modality": [
    "үүрэг"
   ]
  },
  {
   "id": "15.2",
   "number": "15.2",
   "level": 1,
   "article": "art15",
   "parent": "art15",
   "text": "Хүн, хуулийн этгээд, бусад байгууллага нь эрдэнэсийн санд худалдах болон хадгалуулах эрдэнэсийн үнийг хэлэлцэн тохирох, нэхэмжлэн авах эрхтэй.",
   "status": "хүчинтэй",
   "modality": [
    "эрх"
   ]
  },
  {
   "id": "15.3",
   "number": "15.3",
   "level": 1,
   "article": "art15",
   "parent": "art15",
   "text": "Соёлын асуудал эрхэлсэн төрийн захиргааны төв байгууллага нь Монголбанкны хүсэлтийн дагуу түүх, соёлын хосгүй үнэт, үнэт дурсгалт зүйлийн бүртгэл, мэдээллийг гаргаж өгнө.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "16.1",
   "number": "16.1",
   "level": 1,
   "article": "art16",
   "parent": "art16",
   "text": "Эрдэнэсийн сангийн үйл ажиллагаанд Монголбанкны дотоод хяналт шалгалт хийх чиг үүрэг бүхий нэгж, эрх бүхий этгээд хяналт шалгалт хийнэ.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "16.2",
   "number": "16.2",
   "level": 1,
   "article": "art16",
   "parent": "art16",
   "text": "Монголбанк жил бүр Эрдэнэсийн санд тооллого явуулж, тайланг Улсын Их Хуралд танилцуулна.",
   "status": "хүчинтэй",
   "modality": []
  },
  {
   "id": "17.1",
   "number": "17.1",
   "level": 1,
   "article": "art17",
   "parent": "art17",
   "text": "Энэ хуулийг зөрчсөн албан тушаалтны үйлдэл нь гэмт хэргийн шинжгүй бол Төрийн албаны тухай хууль, холбогдох хуульд заасан хариуцлага хүлээлгэнэ.",
   "status": "хүчинтэй",
   "modality": [
    "хариуцлага"
   ]
  },
  {
   "id": "17.2",
   "number": "17.2",
   "level": 1,
   "article": "art17",
   "parent": "art17",
   "text": "Энэ хуулийг зөрчсөн хүн, хуулийн этгээдэд Эрүүгийн хууль, эсхүл Зөрчлийн тухай хуульд заасан хариуцлага хүлээлгэнэ.",
   "status": "хүчинтэй",
   "modality": [
    "хариуцлага"
   ]
  },
  {
   "id": "18.1",
   "number": "18.1",
   "level": 1,
   "article": "art18",
   "parent": "art18",
   "text": "Энэ хуулийг 2022 оны 06 дугаар сарын 01-ний өдрөөс эхлэн дагаж мөрдөнө.",
   "status": "хүчинтэй",
   "modality": []
  }
 ],
