# Copy to .env and fill in. Never commit .env.

# 1 = [ЖИШЭЭ] sample dataset in memory (no Neo4j, no LLM, no network) — the demo default
# 0 = real data/processed via the graph below
MOCK=1
# neo4j (default) | memory (real data without Neo4j)
GRAPH_BACKEND=neo4j

# Neo4j API graph (docker compose --profile graph). Password: 8+ characters.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Claude, used only by the data pipeline (scripts/build_processed_data.py --llm); results are cached
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Embeddings for similar.jsonl (scripts/build_processed_data.py --embed-model)
EMBED_MODEL=BAAI/bge-m3

# Sources (data/pipeline/sources.py)
LAWFORUM_BASE=https://lawforum.parliament.mn
PARLIAMENT_BASE=http://202.21.104.13/ParliamentAPI
PARLIAMENT_USER=
PARLIAMENT_PASS=

# Comma-separated allowed origins for the API (restrict to the Vercel domain in production)
CORS_ORIGINS=*
