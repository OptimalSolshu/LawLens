# Sources
LAWFORUM_BASE=https://lawforum.parliament.mn
PARLIAMENT_BASE=https://www.parliament.mn
PARLIAMENT_USER=
PARLIAMENT_PASS=

# 1 = API serves contracts/fixtures (no Neo4j needed); 0 = real graph queries
MOCK=1
