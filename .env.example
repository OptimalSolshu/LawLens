# Copy to .env and fill in. Never commit .env.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# Claude (data/pipeline/llm.py)
ANTHROPIC_API_KEY=
